                                }
                            }
                            ElseIf ((Arg2 == 0x03))
                            {
                                If (CondRefOf (ISAR))
                                {
                                    Return (ISAR (Arg0, Arg1, Arg2, Arg3))
                                }
                            }
                        }
                    }

                    Return (Buffer (One)
                    {
                         0x00                                             // .
                    })
                }
            }
        }

